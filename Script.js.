function fireworks() {

    const box = document.getElementById("fireworks");

    for(let i=0;i<80;i++){

        const s=document.createElement("div");
        s.className="spark";

        s.style.background=
        `hsl(${Math.random()*360},100%,60%)`;

        s.style.left="50%";
        s.style.top="50%";

        s.style.setProperty("--x",
        (Math.random()*600-300)+"px");

        s.style.setProperty("--y",
        (Math.random()*600-300)+"px");

        box.appendChild(s);

        setTimeout(()=>s.remove(),1200);
    }
}

